{
  "chat.useAgentSkills": true,
  "chat.agentSkillsLocations": { ".github/skills": true },
  "chat.instructionsFilesLocations": { ".github/instructions": true },
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,
  "chat.includeApplyingInstructions": true,
  "chat.includeReferencedInstructions": true,

  // Read-only commands run without a click. Everything else, including every real deploy,
  // asks in VS Code. Do not add "sf": true here: the approval click is the second gate.
  // Patterns forbid shell metacharacters, so chained commands never auto-run.
  "chat.tools.terminal.autoApprove": {
    "/^git (status|diff|log|show|branch|fetch|rev-parse|ls-files|grep)( [^;&|<>`$()\\n]*)?$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^sf (data query|data get record|sobject describe|sobject list|org list metadata|org list metadata-types|project retrieve start|project deploy report) (?=[^\\n]*--target-org intDev( |$))[^;&|<>`$()\\n]*$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^sf project deploy start (?=[^\\n]*--dry-run)(?=[^\\n]*--target-org intDev( |$))[^;&|<>`$()\\n]*$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^(ls|pwd|cat|head|tail|wc|grep)( [^;&|<>`$()\\n]*)?$/": {
      "approve": true,
      "matchCommandLine": true
    }
  },

  "files.exclude": { "**/.DS_Store": true },
  "search.exclude": { "**/node_modules": true, "**/.sfdx": true, "**/.sf": true }
}
