{
  "mcpServers": {
    "ado": {
      "type": "http",
      "url": "https://mcp.dev.azure.com/${ADO_ORG}",
      "headers": {
        "X-MCP-Toolsets": "wit",
        "X-MCP-Readonly": "true"
      },
      "tools": ["*"]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "X-MCP-Toolsets": "context,repos,pull_requests"
      },
      "tools": ["*"]
    }
  }
}
